{
  "name": "viewflux-desktop",
  "productName": "ViewFlux",
  "desktopName": "viewflux",
  "version": "1.1.8",
  "description": "A fast, native YouTube client for Windows, Linux, and macOS focused on searching and watching videos.",
  "main": "./out/main/index.js",
  "author": {
    "name": "ViewFlux Desktop Contributors",
    "email": "contributors@viewflux.app"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node ./node_modules/electron/install.js",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icon": "node scripts/gen-icon.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:all": "electron-vite build && electron-builder -mwl --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shaka-player": "^5.2.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
