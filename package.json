{
  "name": "viewflux-desktop",
  "version": "0.5.1",
  "description": "A fast, native Windows YouTube client focused on searching and watching videos.",
  "main": "./out/main/index.js",
  "author": "ViewFlux Desktop Contributors",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "icon": "node scripts/gen-icon.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shaka-player": "^5.2.12",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
